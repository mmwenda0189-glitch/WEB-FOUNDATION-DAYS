*,
*::before,
*::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    line-height: 1.6;
    color: #333333;
    background-color: #f4f6f8;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

header {
    background-color: #1e293b;
    color: #ffffff;
    text-align: center;
    padding: 2.5rem 1rem 1.5rem 1rem;
}

header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
}

header p {
    color: #cbd5e1;
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
}

header nav ul {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px; /* 16px gap as required */
    list-style: none;
}

header nav a {
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    transition: background-color 0.3s ease, color 0.3s ease;
}

header nav a:hover,
header nav a:focus {
    background-color: #38bdf8;
    color: #0f172a;
}

main {
    max-width: 900px; /* Centred main with maximum width */
    width: 90%;
    margin: 2rem auto;
    flex: 1;
}

section {
    background-color: #ffffff;
    border-radius: 8px;
    padding: 2rem;
    margin-bottom: 2rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
}

section h2, 
section h3 {
    color: #0f172a;
    margin-bottom: 1rem;
    border-bottom: 2px solid #e2e8f0;
    padding-bottom: 0.5rem;
}

section p {
    margin-bottom: 1rem;
} 

#features ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.25rem;
    list-style: none;
    padding: 0;
}

#features ul li {
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-left: 4px solid #38bdf8;
    border-radius: 6px;
    padding: 1.25rem;
    font-weight: 500;
    display: flex;
    align-items: center;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

#features ul li:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.08);
}

#how-to-use ol {
    padding-left: 1.5rem;
}

#how-to-use ol li {
    margin-bottom: 0.5rem;
}

table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1rem;
}

th, td {
    border: 1px solid #cbd5e1;
    padding: 0.75rem 1rem;
    text-align: left;
}

th {
    background-color: #f1f5f9;
    color: #0f172a;
    font-weight: 600;
}

tr:nth-child(even) {
    background-color: #f8fafc;
}

code {
    background-color: #e2e8f0;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-family: Courier New, Courier, monospace;
    font-size: 0.9em;
}

form p {
    margin-bottom: 1.25rem;
}

form label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.35rem;
    color: #334155;
}

form input[type="text"],
form input[type="email"],
form textarea {
    width: 100%; /* Stacked vertically with full width */
    padding: 0.75rem;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-family: inherit;
    font-size: 1rem;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
}

form input:focus,
form textarea:focus {
    outline: none;
    border-color: #0284c7;
    box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.2);
}

/* Button Transitions */
form button {
    background-color: #0284c7;
    color: #ffffff;
    font-size: 1rem;
    font-weight: 600;
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.1s ease;
}

form button:hover {
    background-color: #0369a1;
}

form button:active {
    transform: scale(0.98);
}

footer {
    background-color: #0f172a;
    color: #94a3b8;
    text-align: center;
    padding: 1.5rem;
    font-size: 0.9rem;
    margin-top: auto;
}


@media (max-width: 600px) {
    header {
        padding: 1.5rem 0.75rem 1rem 0.75rem; /* Reduced padding */
    }

    header h1 {
        font-size: 1.8rem; /* Reduced font size */
    }

    header p {
        font-size: 0.95rem;
    }

    section {
        padding: 1.25rem;
    }

    header nav ul {
        gap: 8px;
    }
}